---
import Layout from '../layouts/Layout.astro';

const title = 'Privacy Policy | Smart Marketing Digital';
const description = 'Privacy information for inquiries submitted to Smart Marketing Digital.';
---

<Layout title={title} description={description}>
  <main class="privacy-page">
    <article class="privacy-content">
      <a class="back-link" href="/">&larr; Smart Marketing Digital</a>
      <p class="eyebrow">Privacy Policy</p>
      <h1>How inquiry information is handled</h1>
      <p class="intro">
        This policy explains what information Smart Marketing Digital collects when you submit an inquiry and how that information is used.
      </p>

      <section>
        <h2>Information you provide</h2>
        <p>The intake form may collect:</p>
        <ul>
          <li>Your name and email address</li>
          <li>Your website or business URL</li>
          <li>Your business type and main marketing challenge</li>
          <li>The consulting areas you select</li>
          <li>Your monthly marketing or paid advertising spend selection</li>
          <li>Your goals and any additional context you choose to provide</li>
        </ul>
      </section>

      <section>
        <h2>How the information is used</h2>
        <p>
          The information is used to review your inquiry, understand your business and marketing needs, respond to you, and determine appropriate next steps for a potential consulting engagement.
        </p>
      </section>

      <section>
        <h2>Form processing</h2>
        <p>
          Intake form submissions are sent through Formspree, a third-party form processing service. Information submitted through the form is transmitted to Formspree so the inquiry can be delivered to Smart Marketing Digital. Formspree handles that information under its own privacy practices.
        </p>
      </section>

      <section>
        <h2>Contact</h2>
        <p>
          For questions about this privacy policy or information you submitted, email
          <a href="mailto:smart@stevenmorano.com">smart@stevenmorano.com</a>.
        </p>
      </section>
    </article>
  </main>
</Layout>

<style>
  .privacy-page {
    min-height: 100vh;
    padding: clamp(4rem, 8vw, 7rem) 1.5rem;
    background: #050811;
    color: var(--color-text-dark-primary);
  }

  .privacy-content {
    width: min(100%, 760px);
    margin: 0 auto;
  }

  .back-link {
    display: inline-block;
    margin-bottom: 3rem;
    color: var(--color-text-dark-secondary);
    text-decoration: none;
  }

  .back-link:hover {
    color: var(--color-text-dark-primary);
  }

  .eyebrow {
    margin-bottom: 0.75rem;
    color: var(--color-primary);
    font-family: var(--font-headings);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    margin-bottom: 1.25rem;
    font-size: clamp(2rem, 5vw, 3.25rem);
    line-height: 1.1;
  }

  .intro {
    margin-bottom: 3rem;
    color: var(--color-text-dark-secondary);
    font-size: 1.1rem;
    line-height: 1.7;
  }

  section + section {
    margin-top: 2.25rem;
  }

  h2 {
    margin-bottom: 0.75rem;
    font-size: 1.25rem;
  }

  section p,
  li {
    color: var(--color-text-dark-secondary);
    line-height: 1.7;
  }

  ul {
    margin-top: 0.75rem;
    padding-left: 1.25rem;
  }

  li + li {
    margin-top: 0.35rem;
  }

  section a {
    color: var(--color-secondary);
  }
</style>
